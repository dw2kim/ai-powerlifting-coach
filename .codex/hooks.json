{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; python3 \"$repo_root/scripts/gen_skills_readme.py\"",
            "statusMessage": "Updating Skills table in README"
          }
        ]
      }
    ]
  }
}
