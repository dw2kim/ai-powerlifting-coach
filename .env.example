HEVY_API_KEY=
# Weekly Telegram review (scripts/review/weekly_review.py):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
# End-of-W4 next-block draft → Google Sheet (scripts/sheets/export_block.py):
# Local: a path to the key file. CI (GitHub secret): paste the key's JSON content here.
GOOGLE_SA_JSON=          # e.g. /Users/you/.gcp/powerlifting-sheets.json  — or the {...} JSON itself
# Preferred: a spreadsheet YOU pre-made and shared with the SA (Editor). The SA rewrites
# its tabs each draft (a service account has no Drive quota, so it can't create files).
SHEETS_SPREADSHEET_ID=   # id from the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
# Shared Drive / Workspace only (alternative to the above): create a new Sheet per block.
SHEETS_DRIVE_FOLDER_ID=  # Drive folder to create the draft Sheet in (shared with the SA)
GOOGLE_SHARE_EMAIL=      # optional (folder mode only): email granted writer access
